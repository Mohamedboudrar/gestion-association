# Copy to .env.local (or .env) and fill in real values for your machine.

# Optional — only needed if your backend isn't at the default below.
# Leave commented out (not set to an empty value) to use the default in
# src/api/http.js: http://localhost:8000/api
# VITE_API_BASE_URL=

# TomTom Maps SDK key — required for the project location picker/viewer
# (components/maps/TomTomMapPicker.jsx, TomTomMapViewer.jsx). Leave empty to
# show a friendly "unavailable" placeholder instead of the map.
VITE_TOMTOM_API_KEY=
